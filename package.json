{
  "name": "music-analyzer-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/ui",
    "build": "npm run build --workspace=packages/analyzer && npm run build --workspace=packages/ui",
    "build:analyzer": "npm run build --workspace=packages/analyzer",
    "build:ui": "npm run build --workspace=packages/ui",
    "analyze": "npm start --workspace=packages/analyzer --"
  }
}
