# AcoustID API Key (for MusicBrainz fingerprint lookup)
# Get yours at: https://acoustid.org/new-application
ACOUSTID_API_KEY=your-api-key-here

# Beatport API Credentials (optional - web scraping used if not set)
# Request access at: engineering@beatport.com
BEATPORT_CLIENT_ID=
BEATPORT_CLIENT_SECRET=
BEATPORT_USERNAME=
BEATPORT_PASSWORD=

# Soulseek Credentials (for slskd auto-login)
# Register at: https://www.slsknet.org/news/node/1
SLSKD_USERNAME=
SLSKD_PASSWORD=

# User/Group IDs for file permissions (run: id -u && id -g)
UID=1000
GID=1000
