FROM node:22-slim

# Install yt-dlp, ffmpeg, Docker CLI, sqlite3, fingerprinting tools
RUN apt-get update && apt-get install -y \
    python3 \
    curl \
    ffmpeg \
    docker.io \
    sqlite3 \
    flac \
    libchromaprint-tools \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create directories with correct ownership for node user (UID 1000)
RUN mkdir -p /app/data /app/.nuxt /app/node_modules && chown -R node:node /app

# Switch to node user for npm operations
USER node

# Copy package files (will be overwritten by volume mount, but needed for initial install)
COPY --chown=node:node package*.json ./

# Install dependencies as node user
RUN npm install

EXPOSE 3000

# Default command for dev mode
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
